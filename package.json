{
  "name": "kutupgrup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/generate-llms.mjs",
    "build": "tsc && vite build",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "validate:sitemap": "node scripts/validate-sitemap.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:canonicals": "node scripts/validate-canonicals.mjs",
    "validate:status-codes": "node scripts/validate-status-codes.mjs",
    "validate:llms": "node scripts/validate-llms.mjs",
    "validate:all-seo": "node scripts/validate-all-seo.mjs",
    "start": "node server.js"
  },
  "dependencies": {
    "@studio-freight/react-lenis": "^0.0.47",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.25",
    "nodemailer": "^9.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.1",
    "serve": "^14.2.6",
    "styled-jsx": "^5.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^5",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
